{
  "name": "archive-browser",
  "version": "0.1.0",
  "description": "A local-first desktop browser that automatically archives every page you visit for offline review.",
  "private": true,
  "main": "dist/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n VITE,MAIN -c blue,green \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "cross-env NODE_ENV=development ARCHIVE_BROWSER_VITE_URL=http://localhost:5173 nodemon --watch src/main --watch src/preload --watch src/shared -e ts --exec \"npm run build:main && electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "esbuild src/preload/trusted-preload.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/preload/trusted-preload.js --external:electron",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npm run build && playwright test",
    "fixtures:serve": "node fixtures/server.js",
    "fixtures:serve:site": "node fixtures/siteServer.js",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:win": "npm run build && electron-builder --win --dir",
    "package:mac:dist": "npm run build && electron-builder --mac",
    "package:win:dist": "npm run build && electron-builder --win",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@playwright/test": "^1.48.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^2.1.0"
  }
}
